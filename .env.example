# Node 24+；仅监听本机。工作目录必须已存在且由你明确选定。
PORT=60390
TASK_WORKSPACE=/absolute/path/to/your/workspace
TASK_DB=./var/tasks.sqlite
# 可选：仅演示假 ACP 子进程，不访问模型、不执行 shell。
FAKE_ACP=0
TASK_AUTH=existing
# Codex 真实模式按自己的配置提供 CODEX_HOME 或 CODEX_API_KEY。
# ZCode 项目内隔离登录初始化步骤见 docs/HARNESS-SUBSCRIPTIONS.md。
# 默认随平台启动独立 Codex 订阅连接器。manual 为分开运行。
TASK_CONNECTOR=auto
# 独立执行 npm run connector 时使用（只允许本机 HTTP）。
TASK_PLATFORM_URL=http://127.0.0.1:60390

# 自动运行的本机身份；每个连接器只领取自身目标或无目标任务。
TASK_HARNESSES=Codex
# 独立 npm run connector 的身份：Codex / Grok / ZCode
TASK_HARNESS=Codex
# 1 仅对本项目子进程清除代理变量；0 沿用代理环境。
TASK_DIRECT_NETWORK=0
# 可选：ZCode 打包路径修正与项目内个人模型配置（保持全局配置原样）
# ZCODE_BUILTIN_PROVIDER_CONFIG_FILE=/path/to/project/var/zcode-local/provider/zcode-builtin.json
# ZCODE_PERSONAL_PROVIDER_CONFIG_FILE=/path/to/project/var/zcode-provider.json
# ZCODE_DATA_BASE_DIR=/path/to/project/var/zcode-local
# ZCODE_STORAGE_DIR=/path/to/project/var/zcode-local/.zcode
# ZCODE_HOME=/path/to/project/var/zcode-local/.zcode
# ZCODE_SESSION_DB_PATH=/path/to/project/var/zcode-local/.zcode/cli/db/db.sqlite
